# Copy this file to .env and fill in your values.
# NEVER commit .env (it is in .gitignore).

# ---------------------------------------------------------------------------
# MT5 terminal connection (all optional)
# Leave empty to use the already-open, already-logged-in local MT5 terminal.
# ---------------------------------------------------------------------------
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# ---------------------------------------------------------------------------
# Safety switches
# TRADING_ENABLED=false => the bot NEVER sends real orders.
# DRY_RUN=true          => nothing is sent; the bot only prints the trade it
#                          WOULD execute.
# Change these manually, in this order: Dry Run -> (still Demo) -> Demo live.
# ---------------------------------------------------------------------------
TRADING_ENABLED=false
DRY_RUN=true

# ---------------------------------------------------------------------------
# Symbol (leave SYMBOL empty for automatic gold symbol discovery)
# ---------------------------------------------------------------------------
SYMBOL=
# GOLD_SYMBOL_CANDIDATES=XAUUSD,GOLD,XAUUSDm,XAUUSD.a

# ---------------------------------------------------------------------------
# Strategy / risk overrides (defaults are in gold_trader/config.py)
# ---------------------------------------------------------------------------
# TIMEFRAME=M15
# MAGIC_NUMBER=123456789
# RISK_PER_TRADE=0.005
# MAX_DAILY_LOSS=500
# MAX_SPREAD=0.50
# TRADING_START_TIME=00:00
# TRADING_END_TIME=23:59
# EXPECTED_ACCOUNT_MODE=HEDGING

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# LOG_LEVEL=INFO
