# Copy this file to .env and fill in your values.
# NEVER commit .env (it is in .gitignore).

# ---------------------------------------------------------------------------
# MT5 terminal connection (all optional)
# Leave empty to use the already-open, already-logged-in local MT5 terminal.
# ---------------------------------------------------------------------------
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# ---------------------------------------------------------------------------
# Safety switches
# TRADING_ENABLED=false => the bot NEVER sends real orders.
# DRY_RUN=true          => nothing is sent; the bot only prints the trade it
#                          WOULD execute.
# Change these manually, in this order: Dry Run -> (still Demo) -> Demo live.
# ---------------------------------------------------------------------------
TRADING_ENABLED=false
DRY_RUN=true

# ---------------------------------------------------------------------------
# Symbol (leave SYMBOL empty for automatic gold symbol discovery)
# ---------------------------------------------------------------------------
SYMBOL=
# GOLD_SYMBOL_CANDIDATES=XAUUSD,GOLD,XAUUSDm,XAUUSD.a

# ---------------------------------------------------------------------------
# Strategy / risk overrides (defaults are in gold_trader/config.py)
# ---------------------------------------------------------------------------
# TIMEFRAME=M15
# MAGIC_NUMBER=123456789
# RISK_PER_TRADE=0.005
# MAX_DAILY_LOSS=500
# MAX_SPREAD=0.50
# TRADING_START_TIME=00:00
# TRADING_END_TIME=23:59
# EXPECTED_ACCOUNT_MODE=HEDGING

# ---------------------------------------------------------------------------
# Strategy selection (both engines coexist; nothing is switched on here)
# ACTIVE_STRATEGY=signals   -> original EMA+RSI+candle trend baseline (default)
# ACTIVE_STRATEGY=scalping  -> short-horizon mean reversion, ONLY if
#                              SCALPING_ENABLED=true as well. See SCALPING_REALITY.md.
# ---------------------------------------------------------------------------
# ACTIVE_STRATEGY=signals
# SCALPING_ENABLED=false
# SCALPING_TIMEFRAME=M5      (alias: SCALP_TIMEFRAME)
# --- mandatory cost gate: a scalp smaller than this is refused, always -----
# MIN_PROFIT_TO_SPREAD_RATIO=3.0
# SCALP_SPREAD_SAFETY_MARGIN=0.05
# SCALP_EXPECTED_SPREAD=0.30
# SCALP_MAX_SPREAD=0.45
# --- scalping risk / frequency -------------------------------------------
# SCALPING_RISK_PER_TRADE=0.0015
# SCALP_MAX_TRADES_PER_DAY=6
# SCALPING_DISABLE_MANAGEMENT=true
# --- entry pattern ---------------------------------------------------------
# SCALP_BB_PERIOD=20
# SCALP_BB_STD=2.0
# SCALP_RSI_PERIOD=7
# SCALP_RSI_OVERSOLD=20
# SCALP_RSI_OVERBOUGHT=80
# SCALP_SL_ATR_MULTIPLE=1.2  (alias: SCALP_SL_ATR_MULT)
# SCALP_TP_ATR_MULTIPLE=1.0  (alias: SCALP_TP_ATR_MULT)
# --- volatility window (dead and explosive both rejected) ----------------
# SCALP_VOL_MIN_PERCENTILE=0.10
# SCALP_VOL_MAX_PERCENTILE=0.90
# SCALP_VOL_LOOKBACK=400
# --- backtest costs (0.0 / 1.0 = the original, unchanged model) ----------
# BACKTEST_COMMISSION_PER_LOT=0.0
# BACKTEST_SLIPPAGE_PER_SIDE=0.0
# BACKTEST_SPREAD_STRESS_MULTIPLIER=1.0
# Use the real recorded bid/ask spread per bar when the CSV frame has one
# (research frames only; the live MT5 backtest converts its points column).
# Off by default so the original fixed-spread behaviour is unchanged.
# BACKTEST_USE_RECORDED_SPREAD=false

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# LOG_LEVEL=INFO
